# ==============================================================================
# SAASLINK TECHNOLOGIES LTD — ENTERPRISE ENVIRONMENT CONFIGURATION SPECIFICATION
# ==============================================================================
# Copy this file to '.env' in the project root:
#   cp .env.example .env
# Never commit actual production secrets or passwords to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Environment mode: 'production', 'development', or 'test'
NODE_ENV=production

# Network port and host binding (Default: 3000 on 0.0.0.0 for public/container bind)
PORT=3000
HOST=0.0.0.0

# Canonical Public Domain URL (Used for generating invoice links, receipt PDFs, and webhooks)
APP_URL=https://saaslink.tech

# Allowed CORS origins for external client extranets (comma-separated or '*')
CORS_ORIGINS=https://saaslink.tech,https://app.pijo.shop,https://admin.saaslink.tech


# ------------------------------------------------------------------------------
# 2. RELATIONAL MYSQL 8 ENTERPRISE DATABASE
# ------------------------------------------------------------------------------
# SaaSLink features an internal dual-engine persistence layer.
# When MySQL is configured below, all transactions and tables synchronize to MySQL.
# If credentials are empty during initial setup, it operates on the internal engine.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=saaslink_db
MYSQL_USER=saaslink_user
MYSQL_PASSWORD=replace_with_strong_mysql_password
MYSQL_CONNECTION_LIMIT=20
MYSQL_SSL=false


# ------------------------------------------------------------------------------
# 3. CRYPTOGRAPHIC SECURITY & RBAC AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key used for signing administrative JWT access tokens.
# Generate a strong 64-character random string (e.g., using `openssl rand -hex 32`)
JWT_SECRET=replace_with_high_entropy_64_char_secret_key_for_production_jwt

# Token lifespan (e.g., '7d', '24h', '12h')
JWT_EXPIRES_IN=7d

# Bcrypt password hashing workload factor (Default: 10, production recommended: 12)
BCRYPT_SALT_ROUNDS=10


# ------------------------------------------------------------------------------
# 4. SAFARICOM M-PESA DARAJA 2.0 PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Used for automated STK Push, C2B Paybill instant matching, and B2C landlord payouts.
# Environment: 'sandbox' or 'production'
MPESA_ENV=sandbox

# Daraja Developer App Credentials (from developer.safaricom.co.ke)
MPESA_CONSUMER_KEY=your_mpesa_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_daraja_consumer_secret

# Business Shortcode (Paybill or Till Number)
MPESA_SHORTCODE=400200

# Lipa Na M-Pesa Online Passkey (from Daraja Portal)
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Secure Webhook Callback URLs (Pointed to your domain)
MPESA_CALLBACK_URL=https://saaslink.tech/api/public/payments/mpesa-callback
MPESA_CONFIRMATION_URL=https://saaslink.tech/api/public/payments/mpesa-confirm
MPESA_VALIDATION_URL=https://saaslink.tech/api/public/payments/mpesa-validate


# ------------------------------------------------------------------------------
# 5. KENYA REVENUE AUTHORITY (KRA) eTIMS INTEGRATION
# ------------------------------------------------------------------------------
# Required for Cryptographic QR Code Tax Invoicing (MASUMA ERP, Quotations, Invoices)
KRA_ETIMS_ENV=sandbox
KRA_PIN=P051982341Z
KRA_BRANCH_ID=00
KRA_DEVICE_SERIAL=SAASLINK-ETIMS-KE-01
KRA_ETIMS_API_KEY=your_kra_etims_api_key_secret


# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL & NOTIFICATION DISPATCH (SMTP)
# ------------------------------------------------------------------------------
# SMTP credentials for sending quotation PDF dispatch, lead alerts, and invoice reminders
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@saaslink.tech
SMTP_PASS=replace_with_smtp_password
SMTP_FROM_NAME="SaaSLink Technologies"
SMTP_FROM_EMAIL=notifications@saaslink.tech

# Internal administrative email receiving real-time lead and quote inquiry notifications
ALERT_NOTIFY_EMAIL=operations@saaslink.tech


# ------------------------------------------------------------------------------
# 7. BULK SMS & WHATSAPP BUSINESS CLOUD API
# ------------------------------------------------------------------------------
# Used for instant payment receipt SMS and automated WhatsApp delivery tracking
# Provider: 'africastalking', 'advanta', or 'custom'
SMS_PROVIDER=africastalking
SMS_API_KEY=your_africastalking_api_key
SMS_USERNAME=saaslink_sms
SMS_SENDER_ID=SAASLINK

# Meta WhatsApp Business Cloud API (For Pijo Shop order tracking & PropCloud alerts)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_CLOUD_ACCESS_TOKEN=your_whatsapp_cloud_permanent_access_token


# ------------------------------------------------------------------------------
# 8. GOOGLE AI / GEMINI API
# ------------------------------------------------------------------------------
# Used for intelligent RFP scoping, code generation sandboxes, and automated query analysis
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio


# ------------------------------------------------------------------------------
# 9. CLOUD MEDIA & OBJECT ASSET STORAGE (OPTIONAL)
# ------------------------------------------------------------------------------
# Driver: 'local' (stores in /data and base64) or 's3' (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER=local
S3_BUCKET=saaslink-assets-production
S3_REGION=af-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
